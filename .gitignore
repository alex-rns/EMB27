# PlatformIO build output (the only .gitignore in the repo; it covers every module)
.pio/

# macOS
.DS_Store

# Editor settings (PlatformIO regenerates them; shared settings live in EMB27.code-workspace)
.vscode/

# PlatformIO re-creates a .gitignore in every lesson project whenever it regenerates
# IntelliSense (pio project init). Keep those copies local; this file is the only tracked one.
/module-*/*/.gitignore

# Local Claude Code settings (project skills in .claude/skills/ ARE tracked)
.claude/settings.local.json
