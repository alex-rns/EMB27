# PlatformIO build output (the only .gitignore in the repo; it covers every module)
.pio/

# macOS
.DS_Store

# Editor settings (PlatformIO regenerates them; shared settings live in EMB27.code-workspace)
.vscode/

# PlatformIO re-creates a .gitignore in every project whenever it regenerates
# IntelliSense (pio project init). Keep those copies local; this file is the only tracked one.
/module-*/**/.gitignore

# Local Claude Code settings (project skills in .claude/skills/ ARE tracked)
.claude/settings.local.json

# Wi-Fi credentials for the night light (copy include/secrets.example.h to secrets.h and edit)
secrets.h

# STM32CubeIDE: build output (CubeIDE writes the makefiles here too), debug launch configurations
# (machine-specific, with absolute paths; CubeIDE re-creates them), CubeMX's empty macOS marker and the indexer's
# cache of the compiler's built-in settings (its env-hash changes per machine; CubeIDE re-creates the file)
/module-*/**/Debug/
/module-*/**/Release/
*.launch
.osx.project
/module-*/**/.settings/language.settings.xml

# ESP-IDF projects: the full sdkconfig.<env> is generated on the first build from the project's sdkconfig.defaults,
# which is the tracked source of truth (keep options there, one line each)
/module-*/**/sdkconfig.*
!/module-*/**/sdkconfig.defaults
